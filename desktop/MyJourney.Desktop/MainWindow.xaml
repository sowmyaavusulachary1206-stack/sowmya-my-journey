<Window x:Class="MyJourney.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="My Journey" Height="820" Width="1280" MinHeight="600" MinWidth="820"
        WindowStartupLocation="CenterScreen" Background="#FFF8F0" Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="54" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#FFFFFC" BorderBrush="#F2DDE5" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True" Margin="16,0">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Content="⌂ Home" Click="Home_Click" Margin="4,0" Padding="14,6" Background="#FFF0F5" BorderBrush="#E8CAD7" />
                    <Button Content="↻ Refresh" Click="Refresh_Click" Margin="4,0" Padding="14,6" Background="#FFF0F5" BorderBrush="#E8CAD7" />
                </StackPanel>
                <TextBlock Text="♡  My Journey" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Foreground="#A65F7D" />
            </DockPanel>
        </Border>
        <wv2:WebView2 x:Name="JourneyView" Grid.Row="1" />
    </Grid>
</Window>
